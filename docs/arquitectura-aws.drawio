;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="170" height="135" as="geometry"/></mxCell><mxCell id="tf" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;init · plan · apply · output&lt;br&gt;crea toda la infraestructura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B42BC;strokeColor=none;fontColor=#FFFFFF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="935" width="170" height="60" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color='#D45B07'&gt;━━&lt;/font&gt; Tráfico de usuarios (1→4)&lt;br&gt;&lt;font color='#1A73E8'&gt;┅┅&lt;/font&gt; Flujo CI/CD y despliegue&lt;br&gt;&lt;font color='#C925D1'&gt;┅┅&lt;/font&gt; Replicación de datos&lt;br&gt;&lt;font color='#7D8998'&gt;┅┅&lt;/font&gt; Salida a Internet de las EC2 vía NAT&lt;br&gt;&lt;font color='#E7157B'&gt;┅┅&lt;/font&gt; Métricas a CloudWatch&lt;br&gt;&lt;br&gt;&lt;b&gt;Seguridad:&lt;/b&gt; Internet → SG-ALB → SG-App → SG-DB.&lt;br&gt;Instancias y RDS sin IP pública. IMDSv2 obligatorio.&lt;br&gt;Subredes de BD sin ruta a Internet.&lt;br&gt;Credenciales solo en GitHub Secrets y tfvars no versionado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Datos:&lt;/b&gt; cada EC2 escribe en la primaria y lee de la réplica." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="620" width="280" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
